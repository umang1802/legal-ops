# Local dev values match docker-compose.yml. Never commit a real .env.
NODE_ENV=development
PORT=4100
APP_URL=http://localhost:5190
API_URL=http://localhost:4100
CORS_ALLOWED_ORIGINS=http://localhost:5190

DATABASE_URL=postgres://legalops:legalops@localhost:5433/legalops
REDIS_URL=redis://localhost:6380

SESSION_SECRET=change-me-to-a-long-random-string

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=legalops-documents
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=legalops
S3_SECRET_ACCESS_KEY=legalops-dev-secret
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=26214400

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
SES_CONFIGURATION_SET=
# Email: "smtp" (dev → Mailpit at http://localhost:8025) or "ses" (production). "disabled" leaves emails queued.
EMAIL_PROVIDER=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=LegalOps <notifications@legalops.local>
# Worker
WORKER_POLL_MS=1000
SCHEDULER_POLL_MS=15000
